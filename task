const CloudDB = {
  data: [...INITIAL_PERFUMES],
  async fetchCatalog() {
    return new Promise(r => setTimeout(() => r([...CloudDB.data]), 200));
  },
  async addPerfume(item) {
    return new Promise(r => setTimeout(() => {
      const p = { ...item, id: Date.now().toString() };
      CloudDB.data.unshift(p);
      r(p);
    }, 200));
  },
  async deletePerfume(id) {
    return new Promise(r => setTimeout(() => {
      CloudDB.data = CloudDB.data.filter(p => p.id !== id);
      r(true);
    }, 200));
  }
};

