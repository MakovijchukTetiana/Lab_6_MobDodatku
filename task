export default function App() {
  const [lang, setLang]               = useState('ua');
  const [isDark, setIsDark]           = useState(false);
  const [activeTab, setActiveTab]     = useState('catalog');
  const [currentUser, setCurrentUser] = useState(null);
  const [inputName, setInputName]     = useState('');
  const [inputLogin, setInputLogin]   = useState('');
  const [perfumes, setPerfumes]       = useState([]);
  const [loading, setLoading]         = useState(true);
  const [selectedCat, setSelectedCat] = useState('all');
  const [showDropdown, setShowDropdown]       = useState(false);
  const [selectedPerfume, setSelectedPerfume] = useState(null);
  const [favorites, setFavorites]     = useState([]);
  const [chosenOcc, setChosenOcc]     = useState('date');
  const [matchedPerfume, setMatchedPerfume]   = useState(null);
  const [showAddModal, setShowAddModal]       = useState(false);
  const [newName, setNewName]         = useState('');
  const [newBrand, setNewBrand]       = useState('');
  const [newCat, setNewCat]           = useState('floral');
  const [newSummary, setNewSummary]   = useState('');
  const [newNotes, setNewNotes]       = useState('');

  const t = DICT[lang];

  useEffect(() => { loadCatalog(); }, []);

  const loadCatalog = async () => {
    setLoading(true);
    setPerfumes(await CloudDB.fetchCatalog());
    setLoading(false);
  };

  const handleLogin = (isGuest = false) => {
    if (isGuest) {
      setCurrentUser({ name: lang === 'ua' ? 'Гість' : 'Guest', login: 'guest', role: 'guest' });
      return;
    }
    if (!inputName.trim() || !inputLogin.trim()) {
      Alert.alert('!', lang === 'ua' ? "Введіть ім'я та логін" : 'Enter name and login'); return;
    }
    const login = inputLogin.trim().toLowerCase();
    setCurrentUser({ name: inputName.trim(), login, role: login === 'admin' ? 'admin' : 'user' });
  };

  const handleLogout = () => {
    setCurrentUser(null); setInputName(''); setInputLogin('');
    setSelectedPerfume(null); setActiveTab('catalog');
  };

  const toggleFav = (id) => {
    if (currentUser?.role === 'guest') {
      Alert.alert('', t.guestNotice); return;
    }
    setFavorites(p => p.includes(id) ? p.filter(f => f !== id) : [...p, id]);
  };

  const handleDelete = async (id, name) => {
    Alert.alert(name, t.deleteConfirm, [
      { text: t.cancelBtn, style: 'cancel' },
      { text: t.deleteAction, style: 'destructive', onPress: async () => {
          await CloudDB.deletePerfume(id); await loadCatalog();
      }},
    ]);
  };

  const handleAdd = async () => {
    if (!newName.trim() || !newBrand.trim()) {
      Alert.alert('!', lang === 'ua' ? 'Введіть назву та бренд!' : 'Enter name and brand!'); return;
    }
    await CloudDB.addPerfume({
      name: newName.trim(), brand: newBrand.trim(), category: newCat, occasion: 'date',
      volume: '50 ml (EDP)', longevity: '8-10 год', image: DEFAULT_BOTTLE,
      summary_ua: newSummary || 'Новий аромат.', summary_en: newSummary || 'New fragrance.',
      top_ua: newNotes || 'Бергамот', top_en: newNotes || 'Bergamot',
      heart_ua: 'Жасмин, Троянда', heart_en: 'Jasmine, Rose',
      base_ua: 'Амбра, Мускус',    base_en: 'Amber, Musk',
    });
    setNewName(''); setNewBrand(''); setNewSummary(''); setNewNotes('');
    setShowAddModal(false); await loadCatalog();
  };

  const handleFindMatch = () => {
    const pool = perfumes.filter(p => p.occasion === chosenOcc);
    setMatchedPerfume((pool.length ? pool : perfumes)[Math.floor(Math.random() * (pool.length || perfumes.length))]);
  };

  const filtered   = perfumes.filter(p => selectedCat === 'all' || p.category === selectedCat);
  const favList    = perfumes.filter(p => favorites.includes(p.id));
  const catObj     = t.categories.find(c => c.id === selectedCat);

  const TH = {
    bg:       isDark ? '#0f0f11' : '#f5f5f7',
    card:     isDark ? '#1c1c22' : '#ffffff',
    text:     isDark ? '#f0f0f2' : '#111111',
    sub:      isDark ? '#8e8e99' : '#666666',
    border:   isDark ? '#2a2a34' : '#eeeeee',
    input:    isDark ? '#252530' : '#f0f0f3',
    header:   isDark ? '#16161c' : '#ffffff',
    nav:      isDark ? '#16161c' : '#ffffff',
    accent:   '#ad1457',
  };

  // ────────────── ЕКРАН АВТОРИЗАЦІЇ ──────────────────────────────────
  if (!currentUser) return (
    <SafeAreaView style={[S.fill, { backgroundColor: TH.bg }]}>
      <ScrollView contentContainerStyle={S.loginWrap}>

        <View style={S.topCtrl}>
          <TouchableOpacity style={[S.pill, { backgroundColor: TH.card, borderColor: TH.border }]}
            onPress={() => setLang(lang === 'ua' ? 'en' : 'ua')}>
            <Text style={[S.pillTxt, { color: TH.text }]}>{lang === 'ua' ? '🇺🇦 UA' : '🇬🇧 EN'}</Text>
          </TouchableOpacity>
          <TouchableOpacity style={[S.pill, { backgroundColor: TH.card, borderColor: TH.border }]}
            onPress={() => setIsDark(!isDark)}>
            <Text style={[S.pillTxt, { color: TH.text }]}>{isDark ? '🌙' : '☀️'}</Text>
          </TouchableOpacity>
        </View>

        <Text style={{ fontSize: 52, textAlign: 'center', marginBottom: 4 }}>🌸</Text>
        <Text style={[S.appTitle, { color: TH.text }]}>{t.appTitle}</Text>

        <View style={[S.card, { backgroundColor: TH.card, borderColor: TH.border, marginTop: 20 }]}>
          <Text style={[S.cardTitle, { color: TH.text }]}>{t.authTitle}</Text>

          <Text style={[S.lbl, { color: TH.sub }]}>{t.nameLabel}</Text>
          <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text }]}
            placeholder={t.namePh} placeholderTextColor="#888"
            value={inputName} onChangeText={setInputName} />

          <Text style={[S.lbl, { color: TH.sub }]}>{t.loginLabel}</Text>
          <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text }]}
            placeholder={t.loginPh} placeholderTextColor="#888"
            value={inputLogin} onChangeText={setInputLogin} autoCapitalize="none" />

          <TouchableOpacity style={[S.btn, { backgroundColor: TH.accent, marginTop: 14 }]} onPress={() => handleLogin(false)}>
            <Text style={S.btnTxt}>{t.loginBtn}</Text>
          </TouchableOpacity>

          <View style={[S.div, { backgroundColor: TH.border }]} />

          <TouchableOpacity style={[S.btn, { backgroundColor: '#546e7a' }]} onPress={() => handleLogin(true)}>
            <Text style={S.btnTxt}>{t.guestBtn}</Text>
          </TouchableOpacity>
        </View>

      </ScrollView>
    </SafeAreaView>
  );

  // ────────────── ГОЛОВНИЙ ЕКРАН ─────────────────────────────────────
  return (
    <SafeAreaView style={[S.fill, { backgroundColor: TH.bg }]}>

      {/* ШАПКА */}
      <View style={[S.header, { backgroundColor: TH.header, borderBottomColor: TH.border }]}>
        <View style={S.row}>
          <Text style={[S.appTitle, { color: TH.text, fontSize: 18 }]}>{t.appTitle}</Text>
          <View style={S.row}>
            <TouchableOpacity style={[S.miniBtn, { backgroundColor: TH.input }]}
              onPress={() => setLang(lang === 'ua' ? 'en' : 'ua')}>
              <Text>{lang === 'ua' ? '🇺🇦' : '🇬🇧'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[S.miniBtn, { backgroundColor: TH.input, marginHorizontal: 6 }]}
              onPress={() => setIsDark(!isDark)}>
              <Text>{isDark ? '🌙' : '☀️'}</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[S.miniBtn, { backgroundColor: '#ffebee' }]} onPress={handleLogout}>
              <Text style={{ color: '#c62828', fontWeight: 'bold', fontSize: 12 }}>
                {lang === 'ua' ? 'Вихід' : 'Exit'}
              </Text>
            </TouchableOpacity>
          </View>
        </View>
        {/* Бейдж ролі */}
        <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 6 }}>
          <Text style={{ color: TH.sub, fontSize: 12 }}>
            {currentUser.name}
          </Text>
          <View style={[S.roleTag, currentUser.role === 'admin' ? S.tagAdmin : currentUser.role === 'user' ? S.tagUser : S.tagGuest, { marginLeft: 8 }]}>
            <Text style={S.roleTagTxt}>
              {currentUser.role === 'admin' ? t.roleTagAdmin : currentUser.role === 'user' ? t.roleTagUser : t.roleTagGuest}
            </Text>
          </View>
        </View>
      </View>

      {/* ВМІСТ ВКЛАДОК */}
      <View style={{ flex: 1 }}>

        {/* ── 🌸 КАТАЛОГ ── */}
        {activeTab === 'catalog' && (
          <ScrollView style={{ flex: 1, paddingHorizontal: 14 }}>
            <View style={[S.ddSection]}>
              <Text style={[S.secLbl, { color: TH.sub }]}>{t.catLabel}</Text>
              <TouchableOpacity style={[S.ddSelector, { backgroundColor: TH.card, borderColor: TH.accent }]}
                onPress={() => setShowDropdown(true)}>
                <Text style={[{ fontSize: 14, fontWeight: 'bold', color: TH.text }]}>{catObj?.label}</Text>
                <Text style={{ color: TH.accent, fontWeight: 'bold' }}>▼</Text>
              </TouchableOpacity>
            </View>

            {currentUser.role === 'admin' && (
              <TouchableOpacity style={[S.btn, { backgroundColor: TH.accent, marginBottom: 10 }]}
                onPress={() => setShowAddModal(true)}>
                <Text style={S.btnTxt}>{t.adminAddBtn}</Text>
              </TouchableOpacity>
            )}

            <Text style={[S.secLbl, { color: TH.sub, marginVertical: 6 }]}>{t.catalogTitle}</Text>

            {loading ? <ActivityIndicator color={TH.accent} style={{ marginTop: 30 }} size="large" /> :
              filtered.map(item => {
                const isFav = favorites.includes(item.id);
                return (
                  <TouchableOpacity key={item.id}
                    style={[S.pCard, { backgroundColor: TH.card, borderColor: TH.border }]}
                    onPress={() => setSelectedPerfume(item)} activeOpacity={0.88}>
                    <Image source={{ uri: item.image }} style={S.bottleImg}
                      defaultSource={{ uri: DEFAULT_BOTTLE }} />
                    <View style={{ flex: 1, marginLeft: 12 }}>
                      <Text style={S.brand}>{item.brand}</Text>
                      <Text style={[S.pName, { color: TH.text }]}>{item.name}</Text>
                      <View style={S.metaRow}>
                        <Text style={[S.badge, { backgroundColor: isDark ? '#1a2a5e' : '#e3f2fd', color: isDark ? '#90caf9' : '#1565c0' }]}>{item.volume}</Text>
                        <Text style={[S.badge, { backgroundColor: isDark ? '#3e2000' : '#fff3e0', color: '#e65100' }]}>⏳ {item.longevity}</Text>
                      </View>
                      <Text style={{ fontSize: 11, color: TH.accent, fontWeight: '600', marginTop: 4 }}>{t.clickDetails}</Text>
                    </View>
                    <View style={{ justifyContent: 'space-between', alignItems: 'flex-end' }}>
                      <TouchableOpacity onPress={() => toggleFav(item.id)} style={S.favBtn}>
                        <Text style={{ fontSize: 18 }}>{isFav ? '❤️' : '🤍'}</Text>
                      </TouchableOpacity>
                      {currentUser.role === 'admin' && (
                        <TouchableOpacity onPress={() => handleDelete(item.id, item.name)} style={{ padding: 4 }}>
                          <Text style={{ fontSize: 14 }}>🗑️</Text>
                        </TouchableOpacity>
                      )}
                    </View>
                  </TouchableOpacity>
                );
              })}
            <View style={{ height: 30 }} />
          </ScrollView>
        )}

        {/* ── ✨ ПІДБІР ── */}
        {activeTab === 'quiz' && (
          <ScrollView style={{ flex: 1, padding: 14 }}>
            <View style={[S.card, { backgroundColor: TH.card, borderColor: TH.border }]}>
              <Text style={[S.cardTitle, { color: TH.text }]}>{t.quizTitle}</Text>
              <Text style={{ fontSize: 13, color: TH.sub, marginBottom: 12 }}>{t.quizSub}</Text>

              {t.occasions.map(occ => {
                const sel = chosenOcc === occ.id;
                return (
                  <TouchableOpacity key={occ.id}
                    style={[S.occBtn, { backgroundColor: sel ? (isDark ? '#2a1a24' : '#fce4ec') : TH.input, borderColor: sel ? TH.accent : TH.border }]}
                    onPress={() => setChosenOcc(occ.id)}>
                    <Text style={[{ fontSize: 14, fontWeight: sel ? 'bold' : 'normal', color: TH.text }]}>{occ.title}</Text>
                    <Text style={{ fontSize: 11, color: TH.sub }}>{occ.desc}</Text>
                  </TouchableOpacity>
                );
              })}

              <TouchableOpacity style={[S.btn, { backgroundColor: TH.accent, marginTop: 14 }]} onPress={handleFindMatch}>
                <Text style={S.btnTxt}>{t.findBtn}</Text>
              </TouchableOpacity>
            </View>

            {matchedPerfume && (
              <View style={[S.card, { backgroundColor: TH.card, borderColor: TH.accent, marginTop: 16 }]}>
                <Text style={{ fontSize: 12, fontWeight: 'bold', color: TH.accent, marginBottom: 6 }}>{t.matchTitle}</Text>
                <View style={S.row}>
                  <Image source={{ uri: matchedPerfume.image }} style={{ width: 60, height: 80, borderRadius: 6, resizeMode: 'contain' }} />
                  <View style={{ flex: 1, marginLeft: 12 }}>
                    <Text style={S.brand}>{matchedPerfume.brand}</Text>
                    <Text style={[S.pName, { color: TH.text, fontSize: 16 }]}>{matchedPerfume.name}</Text>
                    <TouchableOpacity onPress={() => setSelectedPerfume(matchedPerfume)} style={{ marginTop: 6 }}>
                      <Text style={{ fontSize: 12, color: TH.accent, fontWeight: 'bold' }}>{t.clickDetails}</Text>
                    </TouchableOpacity>
                  </View>
                </View>
              </View>
            )}
            <View style={{ height: 30 }} />
          </ScrollView>
        )}

        {/* ── ❤️ ОБРАНЕ ── */}
        {activeTab === 'fav' && (
          <ScrollView style={{ flex: 1, padding: 14 }}>
            <Text style={[S.secLbl, { color: TH.sub, marginBottom: 10 }]}>{t.tabs.fav}</Text>
            {favList.length === 0 ? (
              <View style={{ alignItems: 'center', marginTop: 60 }}>
                <Text style={{ fontSize: 40, marginBottom: 10 }}>🤍</Text>
                <Text style={{ textAlign: 'center', color: TH.sub, fontSize: 14, lineHeight: 20 }}>{t.emptyFav}</Text>
              </View>
            ) : (
              favList.map(item => (
                <TouchableOpacity key={item.id}
                  style={[S.pCard, { backgroundColor: TH.card, borderColor: TH.border }]}
                  onPress={() => setSelectedPerfume(item)} activeOpacity={0.88}>
                  <Image source={{ uri: item.image }} style={S.bottleImg} />
                  <View style={{ flex: 1, marginLeft: 12 }}>
                    <Text style={S.brand}>{item.brand}</Text>
                    <Text style={[S.pName, { color: TH.text }]}>{item.name}</Text>
                    <Text style={{ fontSize: 11, color: TH.accent, fontWeight: '600', marginTop: 4 }}>{t.clickDetails}</Text>
                  </View>
                  <TouchableOpacity onPress={() => toggleFav(item.id)} style={S.favBtn}>
                    <Text style={{ fontSize: 18 }}>❤️</Text>
                  </TouchableOpacity>
                </TouchableOpacity>
              ))
            )}
            <View style={{ height: 30 }} />
          </ScrollView>
        )}

        {/* ── 👤 ПРОФІЛЬ ── */}
        {activeTab === 'profile' && (
          <ScrollView style={{ flex: 1, padding: 14 }}>
            <View style={[S.card, { backgroundColor: TH.card, borderColor: TH.border }]}>
              <Text style={[S.cardTitle, { color: TH.text }]}>{t.tabs.profile}</Text>
              <View style={{ alignItems: 'center', marginVertical: 16 }}>
                <Text style={{ fontSize: 48, marginBottom: 8 }}>🌸</Text>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: TH.text }}>{currentUser.name}</Text>
                <View style={[S.roleTag, currentUser.role === 'admin' ? S.tagAdmin : currentUser.role === 'user' ? S.tagUser : S.tagGuest, { marginTop: 6 }]}>
                  <Text style={S.roleTagTxt}>
                    {currentUser.role === 'admin' ? t.roleTagAdmin : currentUser.role === 'user' ? t.roleTagUser : t.roleTagGuest}
                  </Text>
                </View>
              </View>
              
              <View style={[S.div, { backgroundColor: TH.border }]} />
              
              <Text style={[S.secLbl, { color: TH.sub, marginTop: 10 }]}>{t.settingsTitle}</Text>
              
              <View style={[S.row, { marginVertical: 10 }]}>
                <Text style={{ color: TH.text, fontSize: 14 }}>{t.langSetting}</Text>
                <TouchableOpacity style={[S.pill, { backgroundColor: TH.input, borderColor: TH.border }]}
                  onPress={() => setLang(lang === 'ua' ? 'en' : 'ua')}>
                  <Text style={[S.pillTxt, { color: TH.text }]}>{lang === 'ua' ? '🇺🇦 UA' : '🇬🇧 EN'}</Text>
                </TouchableOpacity>
              </View>

              <View style={[S.row, { marginVertical: 10 }]}>
                <Text style={{ color: TH.text, fontSize: 14 }}>{t.themeSetting}</Text>
                <TouchableOpacity style={[S.pill, { backgroundColor: TH.input, borderColor: TH.border }]}
                  onPress={() => setIsDark(!isDark)}>
                  <Text style={[S.pillTxt, { color: TH.text }]}>{isDark ? t.themeDark : t.themeLight}</Text>
                </TouchableOpacity>
              </View>

              <TouchableOpacity style={[S.btn, { backgroundColor: '#c62828', marginTop: 20 }]} onPress={handleLogout}>
                <Text style={S.btnTxt}>{t.logout}</Text>
              </TouchableOpacity>
            </View>
            <View style={{ height: 30 }} />
          </ScrollView>
        )}

      </View>

      {/* НИЖНЯ ПАНЕЛЬ НАВІГАЦІЇ */}
      <View style={[S.navBar, { backgroundColor: TH.nav, borderTopColor: TH.border }]}>
        {[
          { id: 'catalog', label: t.tabs.catalog },
          { id: 'quiz',    label: t.tabs.quiz },
          { id: 'fav',     label: t.tabs.fav },
          { id: 'profile', label: t.tabs.profile },
        ].map(tab => {
          const active = activeTab === tab.id;
          return (
            <TouchableOpacity key={tab.id} style={S.navItem} onPress={() => setActiveTab(tab.id)}>
              <Text style={[{ fontSize: 12, fontWeight: active ? 'bold' : 'normal', color: active ? TH.accent : TH.sub }]}>
                {tab.label}
              </Text>
            </TouchableOpacity>
          );
        })}
      </View>

      {/* МОДАЛЬНЕ ВІКНО ВИБОРУ КАТЕГОРІЇ (DropDown) */}
      <Modal visible={showDropdown} transparent animationType="fade">
        <View style={S.modalOverlay}>
          <View style={[S.modalContent, { backgroundColor: TH.card }]}>
            <Text style={[S.cardTitle, { color: TH.text, marginBottom: 12 }]}>{t.modalPickCat}</Text>
            {t.categories.map(cat => (
              <TouchableOpacity key={cat.id}
                style={[S.modalItem, { borderBottomColor: TH.border }]}
                onPress={() => { setSelectedCat(cat.id); setShowDropdown(false); }}>
                <Text style={[{ fontSize: 15, color: selectedCat === cat.id ? TH.accent : TH.text, fontWeight: selectedCat === cat.id ? 'bold' : 'normal' }]}>
                  {cat.label}
                </Text>
              </TouchableOpacity>
            ))}
            <TouchableOpacity style={[S.btn, { backgroundColor: '#546e7a', marginTop: 16 }]} onPress={() => setShowDropdown(false)}>
              <Text style={S.btnTxt}>{t.closeWin}</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>

      {/* МОДАЛЬНЕ ВІКНО ДЕТАЛЕЙ ПАРФУМУ */}
      <Modal visible={!!selectedPerfume} transparent animationType="slide">
        {selectedPerfume && (
          <View style={S.modalOverlay}>
            <View style={[S.modalDetails, { backgroundColor: TH.card }]}>
              <ScrollView showsVerticalScrollIndicator={false}>
                <Image source={{ uri: selectedPerfume.image }} style={S.detailImg} />
                <Text style={S.brand}>{selectedPerfume.brand}</Text>
                <Text style={[S.pName, { color: TH.text, fontSize: 20, marginBottom: 8 }]}>{selectedPerfume.name}</Text>
                
                <View style={S.metaRow}>
                  <Text style={[S.badge, { backgroundColor: isDark ? '#1a2a5e' : '#e3f2fd', color: isDark ? '#90caf9' : '#1565c0' }]}>{selectedPerfume.volume}</Text>
                  <Text style={[S.badge, { backgroundColor: isDark ? '#3e2000' : '#fff3e0', color: '#e65100' }]}>⏳ {selectedPerfume.longevity}</Text>
                </View>

                <Text style={[S.secLbl, { color: TH.sub, marginTop: 14 }]}>{t.summaryTitle}</Text>
                <Text style={{ color: TH.text, fontSize: 13, lineHeight: 18, marginTop: 4 }}>
                  {lang === 'ua' ? selectedPerfume.summary_ua : selectedPerfume.summary_en}
                </Text>

                <Text style={[S.secLbl, { color: TH.sub, marginTop: 14 }]}>{t.pyramidTitle}</Text>
                <View style={[S.pyramidBox, { backgroundColor: TH.input }]}>
                  <Text style={{ fontSize: 12, color: TH.text, marginBottom: 4 }}><Text style={{ fontWeight: 'bold' }}>{t.topNotes}</Text> {lang === 'ua' ? selectedPerfume.top_ua : selectedPerfume.top_en}</Text>
                  <Text style={{ fontSize: 12, color: TH.text, marginBottom: 4 }}><Text style={{ fontWeight: 'bold' }}>{t.heartNotes}</Text> {lang === 'ua' ? selectedPerfume.heart_ua : selectedPerfume.heart_en}</Text>
                  <Text style={{ fontSize: 12, color: TH.text }}><Text style={{ fontWeight: 'bold' }}>{t.baseNotes}</Text> {lang === 'ua' ? selectedPerfume.base_ua : selectedPerfume.base_en}</Text>
                </View>

                <TouchableOpacity style={[S.btn, { backgroundColor: TH.accent, marginTop: 16 }]}
                  onPress={() => toggleFav(selectedPerfume.id)}>
                  <Text style={S.btnTxt}>
                    {favorites.includes(selectedPerfume.id) ? t.favRemove : t.favAdd}
                  </Text>
                </TouchableOpacity>

                <TouchableOpacity style={[S.btn, { backgroundColor: '#546e7a', marginTop: 8 }]}
                  onPress={() => setSelectedPerfume(null)}>
                  <Text style={S.btnTxt}>{t.closeWin}</Text>
                </TouchableOpacity>
              </ScrollView>
            </View>
          </View>
        )}
      </Modal>

      {/* МОДАЛЬНЕ ВІКНО ДОДАВАННЯ ПАРФУМУ (ДЛЯ АДМІНА) */}
      <Modal visible={showAddModal} transparent animationType="slide">
        <View style={S.modalOverlay}>
          <View style={[S.modalDetails, { backgroundColor: TH.card }]}>
            <ScrollView showsVerticalScrollIndicator={false}>
              <Text style={[S.cardTitle, { color: TH.text, marginBottom: 12 }]}>{t.adminModalTitle}</Text>
              
              <Text style={[S.lbl, { color: TH.sub }]}>Бренд:</Text>
              <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text }]}
                placeholder="напр. Tom Ford" placeholderTextColor="#888"
                value={newBrand} onChangeText={setNewBrand} />

              <Text style={[S.lbl, { color: TH.sub }]}>Назва парфуму:</Text>
              <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text }]}
                placeholder="напр. Bitter Peach" placeholderTextColor="#888"
                value={newName} onChangeText={setNewName} />

              <Text style={[S.lbl, { color: TH.sub }]}>Рубрика:</Text>
              <View style={{ flexDirection: 'row', flexWrap: 'wrap', marginBottom: 8 }}>
                {['floral', 'oriental', 'woody', 'fresh'].map(catId => (
                  <TouchableOpacity key={catId}
                    style={[S.miniPill, { backgroundColor: newCat === catId ? TH.accent : TH.input }]}
                    onPress={() => setNewCat(catId)}>
                    <Text style={{ fontSize: 11, color: newCat === catId ? '#fff' : TH.text }}>{catId}</Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text style={[S.lbl, { color: TH.sub }]}>Короткий опис:</Text>
              <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text, height: 60 }]}
                placeholder="Опис аромату..." placeholderTextColor="#888"
                multiline value={newSummary} onChangeText={setNewSummary} />

              <Text style={[S.lbl, { color: TH.sub }]}>Верхні ноти:</Text>
              <TextInput style={[S.inp, { backgroundColor: TH.input, color: TH.text }]}
                placeholder="напр. Персик, Апельсин" placeholderTextColor="#888"
                value={newNotes} onChangeText={setNewNotes} />

              <TouchableOpacity style={[S.btn, { backgroundColor: TH.accent, marginTop: 14 }]} onPress={handleAdd}>
                <Text style={S.btnTxt}>{t.saveBtn}</Text>
              </TouchableOpacity>

              <TouchableOpacity style={[S.btn, { backgroundColor: '#546e7a', marginTop: 8 }]} onPress={() => setShowAddModal(false)}>
                <Text style={S.btnTxt}>{t.cancelBtn}</Text>
              </TouchableOpacity>
            </ScrollView>
          </View>
        </View>
      </Modal>

    </SafeAreaView>
  );
}

