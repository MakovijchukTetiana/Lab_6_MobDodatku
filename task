    saveBtn: '💾 Save',
    cancelBtn: 'Cancel',
    guestNotice: 'Please log in to save fragrances!',
    deleteConfirm: 'Remove from catalog?',
    deleteAction: 'Delete',
    tabs: { catalog: '🌸 Catalog', quiz: '✨ Matcher', fav: '❤️ Favorites', profile: '👤 Profile' },
    quizTitle: '✨ Personal Scent Matcher',
    quizSub: 'Choose your vibe — we will find your perfect fragrance:',
    findBtn: 'Match My Scent ✨',
    matchTitle: 'YOUR MATCH:',
    emptyFav: 'No favorites yet.\nTap ❤️ on any bottle!',
    settingsTitle: 'SETTINGS',
    langSetting: 'Language / Мова',
    themeSetting: 'Theme / Тема',
    themeLight: '☀️ Light',
    themeDark: '🌙 Dark',
    occasions: [
      { id: 'date',   title: '🌹 Romantic Date Night',     desc: 'Sensual and mysterious trail' },
      { id: 'work',   title: '💼 Business & Office',        desc: 'Clean, elegant signature' },
      { id: 'party',  title: '💃 Night Out & Party',        desc: 'Bold and head-turning energy' },
      { id: 'relax',  title: '☕ Cozy Evening at Home',     desc: 'Warm spices and vanilla comfort' },
      { id: 'summer', title: '🌊 Summer & Beach',           desc: 'Marine salt and zesty citrus' },
    ],
    categories: [
      { id: 'all',      label: '🌟 All Categories' },
      { id: 'floral',   label: '🌸 Floral Fragrances' },
      { id: 'oriental', label: '✨ Oriental & Spicy' },
